{
  "name": "mura-trails",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run check:legal",
    "build": "npm run check:content && next build && node scripts/check-rsc.mjs",
    "start": "node scripts/copy-standalone-assets.mjs && node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 0",
    "check:legal": "tsx scripts/check-legal.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:rsc": "node scripts/check-rsc.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "generate:placeholders": "tsx scripts/generate-placeholders.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.26",
    "motion": "^13.2.0",
    "next": "15.5.25",
    "next-intl": "^4.14.4",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
